#!/usr/bin/env bash
# terraform-dirs - print each directory under the current one that holds .tf or .tf.json files
# Usage: terraform-dirs
set -euo pipefail

tf_files="$(find . \( -name "*.tf" -o -name "*.tf.json" \) -not -path "*/.terraform/*")"
if [[ -z "${tf_files}" ]]; then
  echo "terraform-dirs: no .tf or .tf.json files under ${PWD}" >&2
  exit 1
fi

tf_dirs=""
while IFS= read -r tf_file; do
  tf_dirs+="$(dirname "${tf_file}")"$'\n'
done <<< "${tf_files}"
printf '%s' "${tf_dirs}" | sort -u
